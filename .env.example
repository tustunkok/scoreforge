# Configuration for ScoreForge (docker compose / local runs).
# Copy to .env and adjust.

# Where jobs, artifacts and the SQLite database live.
SCOREFORGE_DATA_DIR=/data

# cpu or cuda
SCOREFORGE_DEVICE=cpu

# Path to the MuseScore 4 executable, if it is not in a standard location.
# The Docker image already sets this to its bundled copy; override it only for
# a local checkout or a host mount.
# SCOREFORGE_MUSESCORE=/usr/local/bin/mscore

# The notation model (DuET) and the audio frontend.
SCOREFORGE_MODEL=Wayne42/DuET

# Submissions per client address per window.
SCOREFORGE_RATE_LIMIT=5
SCOREFORGE_RATE_WINDOW=3600

# How many submissions may wait at once before /submit answers 503.
SCOREFORGE_MAX_QUEUE_DEPTH=20

# Set to 1 only when a reverse proxy in front of the app sets
# X-Forwarded-For; otherwise the header is ignored.
# SCOREFORGE_TRUST_PROXY=1

# Comma-separated Host header allow-list. Empty accepts any host.
# SCOREFORGE_ALLOWED_HOSTS=scoreforge.example.com

# How long finished results stay downloadable (hours).
SCOREFORGE_RESULT_TTL_HOURS=24

# How often expired results are swept up (seconds).
SCOREFORGE_SWEEP_INTERVAL=900

# Refuse new work when the data volume has less free space than this (MB),
# or when this many result folders already sit on disk.
SCOREFORGE_MIN_FREE_MB=1024
SCOREFORGE_MAX_JOBS_ON_DISK=200

# Web server.
SCOREFORGE_HOST=0.0.0.0
SCOREFORGE_PORT=8000

# Logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
SCOREFORGE_LOG_LEVEL=INFO
# Optional rotating log file.
# SCOREFORGE_LOG_FILE=/data/scoreforge.log
